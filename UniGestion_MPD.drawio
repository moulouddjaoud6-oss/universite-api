        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ROLE ||--o{ UTILISATEUR : possede\n    UTILISATEUR ||--o| ETUDIANT : possede\n    UTILISATEUR ||--o| PROFESSEUR : possede\n    DEPARTEMENT ||--o{ PROFESSEUR : contient\n    DEPARTEMENT ||--o{ COURS : propose\n    PROFESSEUR ||--o{ COURS : enseigne\n    ETUDIANT ||--o{ INSCRIPTION : effectue\n    COURS ||--o{ INSCRIPTION : concerne\n    INSCRIPTION ||--o| NOTE : recoit\n\n    ROLE {\n        int id PK\n        string nom\n    }\n\n    UTILISATEUR {\n        int id PK\n        string nom\n        string prenom\n        string email\n        string motDePasse\n        string photo\n        int roleId FK\n    }\n\n    ETUDIANT {\n        int id PK\n        string matricule\n        date dateNaissance\n        string adresse\n        string telephone\n        string photo\n        int utilisateurId FK\n    }\n\n    PROFESSEUR {\n        int id PK\n        string specialite\n        string telephone\n        string adresse\n        string photo\n        int utilisateurId FK\n        int departementId FK\n    }\n\n    DEPARTEMENT {\n        int id PK\n        string nom\n    }\n\n    COURS {\n        int id PK\n        string nom\n        string code\n        string description\n        int credits\n        int professeurId FK\n        int departementId FK\n    }\n\n    INSCRIPTION {\n        int id PK\n        int etudiantId FK\n        int coursId FK\n    }\n\n    NOTE {\n        int id PK\n        decimal note\n        string appreciation\n        int inscriptionId FK\n    }&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="DMLM7bmuHBuCvfiXSiol-1">
