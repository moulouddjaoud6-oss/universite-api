{
  "info": {
    "name": "UniGestion API",
    "description": "Collection complète de tests de l'API de gestion universitaire",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@universite.local"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "01 - Santé API",
      "item": [
        {
          "name": "Vérifier API",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "02 - Authentification",
      "item": [
        {
          "name": "Connexion administrateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  if (data.token) {",
                  "    pm.collectionVariables.set('token', data.token);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"motDePasse\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/connexion"
          }
        }
      ]
    },
    {
      "name": "03 - Rôles",
      "item": [
        {
          "name": "Lister les rôles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/roles"
          }
        }
      ]
    },
    {
      "name": "04 - Utilisateurs",
      "item": [
        {
          "name": "Lister les utilisateurs",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/utilisateurs"
          }
        },
        {
          "name": "Consulter un utilisateur",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/utilisateurs/{{id}}"
          }
        }
      ]
    },
    {
      "name": "05 - Étudiants",
      "item": [
        {
          "name": "Lister les étudiants",
