{
  "info": {
    "name": "UniGestion API",
    "description": "Collection de tests de l'API de gestion universitaire",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Santé API",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "02 - Authentification",
      "item": [
        {
          "name": "Connexion administrateur",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Connexion réussie', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"admin@universite.local\",\"motDePasse\":\"REMPLACER_PAR_TON_MOT_DE_PASSE\"}"
            },
            "url": "{{baseUrl}}/auth/connexion"
          }
        }
      ]
    },
    {
      "name": "03 - Utilisateurs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/utilisateurs"
      }
    },
    {
      "name": "04 - Étudiants",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/etudiants"
      }
    },
    {
      "name": "05 - Professeurs",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/professeurs"
      }
    },
    {
      "name": "06 - Départements",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/departements"
      }
    },
    {
      "name": "07 - Cours",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/cours"
      }
    },
    {
      "name": "08 - Inscriptions",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/inscriptions"
      }
    },
    {
      "name": "09 - Notes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/notes"
      }
    },
    {
      "name": "10 - Rôles",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/roles"
      }
    }
  ]
}